COGNITO_DOMAIN=https://ap-southeast-[your-domain-id].auth.ap-southeast-2.amazoncognito.com
CLIENT_ID=[your-client-id]
CLIENT_SECRET=[your-secret]
SCOPE=openid email
SESSION_SECRET=[your-random-secret-string]
IDENTITY_PROVIDER=[your-intraID-identity-provider]
PORT=3000
APP_DOMAIN=http://localhost:3000
REDIRECT_URI=${APP_DOMAIN}/callback
COGNINTO_LOGOUT_URI=${APP_DOMAIN}/logout